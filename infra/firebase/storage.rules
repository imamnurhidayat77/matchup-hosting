rules_version = '2';

// Upload targets used by StorageService:
//   - uploads/chat-attachments/{activityId}/…  (chat photo attachments)
//   - uploads/profile-photos/…                 (profile avatar uploads)
//
// Writes are authenticated users only, images only, max 10 MB.
// Reads need no rule: the app shares tokenized download URLs
// (getDownloadURL), which work regardless of these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/chat-attachments/{allPaths=**} {
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /uploads/profile-photos/{allPaths=**} {
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
