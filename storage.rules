rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActivityHost(activityId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/activities/$(activityId)).data.hostId == request.auth.uid;
    }

    function isAllowedProfileImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedActivityCoverImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isAllowedProfileImage();
      allow delete: if isOwner(uid);
    }

    match /activities/{activityId}/cover/{fileName} {
      allow read: if true;
      allow create, update: if isActivityHost(activityId) && isAllowedActivityCoverImage();
      allow delete: if isActivityHost(activityId);
    }

    // Chat photo attachments, uploaded by activity participants via
    // StorageService (`uploads/chat-attachments/{activityId}/…`).
    // Membership is enforced at the API layer (POST /api/chat/messages);
    // rules here only require a signed-in uploader and image content.
    match /uploads/chat-attachments/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
