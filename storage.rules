rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAllowedProfileImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedActivityCoverImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isAllowedProfileImage();
      allow delete: if isOwner(uid);
    }

    match /activities/{activityId}/cover/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAllowedActivityCoverImage();
      allow delete: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
