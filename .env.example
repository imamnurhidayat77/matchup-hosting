# =========================================================================
# MatchUp — root environment variables
# Copy this file to `.env` (or app-specific `.env`) and fill in the values.
# Variables consumed by each app are documented below.
# =========================================================================

# -------------------------- API --------------------------
# Port the Express API listens on
PORT=4000

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/matchup

# Secret used to sign JWTs / session tokens
AUTH_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Node environment: development | test | production
NODE_ENV=development

# Log level for pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# -------------------------- Admin Web --------------------------
# Base URL the admin web uses to call the API
VITE_API_BASE_URL=http://localhost:4000

# -------------------------- Mobile --------------------------
# API base URL the Flutter app uses
API_BASE_URL=http://localhost:4000

# Mobile environment label: local | staging | production
APP_ENV=local